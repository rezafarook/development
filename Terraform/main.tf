resource "local_file" "pet" {
    filename = var.filename
    # content = var.content # The value for this is still present in the variables.tf file
    #content = var.file-content["statement1"]
    content = "My favourite pet is ${random_pet.reza.id}"
}

resource "random_pet" "reza" {
    # prefix = var.prefix[0]
    prefix = ""
    separator = var.separator
    length = var.length
}

output  "pet-name" {
    value = random_pet.reza.id
    description = "Record the values of the pet ID generated by random_pet resource"
}